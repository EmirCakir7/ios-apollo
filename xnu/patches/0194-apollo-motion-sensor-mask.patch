+	IOLog("SWEET HID: %s registered (usage 0x%x, mode %d, mask 0x%x, gravity %d,%d,%d mg)\n", getName(),
+	    (unsigned)getPrimaryUsage(), mode, gSweetMotionMask, gSweetGravity[0], gSweetGravity[1], gSweetGravity[2]);
 	if (mode >= 2) {
