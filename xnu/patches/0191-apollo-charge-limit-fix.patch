+/*
+ * xnu 0191: `reg` is the register's whole address as SweetBattery has it (0x1342, 0x1365, 0x1366, 0x1370; the peripheral's
+ * own 8-bit offset goes on the bus). xnu 0190 compared it with the bare offsets 0x42/0x65/0x66/0x70 and so refused every
+ * write before any SPMI transfer (boot-chg1: "write failed", no arbiter status line): that, not the PMIC, was why 0x1370
+ * stayed 0xa. The arbiter's status of the last write, and how many tries it took, are kept for the log.
+ */
+unsigned apollo_pmic_usbin_status(void);
+unsigned apollo_pmic_usbin_tries(void);
