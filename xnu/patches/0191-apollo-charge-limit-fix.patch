+	unsigned status = apollo_pmic_usbin_status(), tries = apollo_pmic_usbin_tries();
 	bool read = !sweet_spmi_read(sweet_battery_sid, kChgRegs[index], &back);
-	IOLog("SWEET BATT: wrote %#06x %#x read back %#x%s\n", kChgRegs[index], value, back,
-	    !wrote ? " (write failed)" : (!read ? " (read back failed)" : ""));
-	return wrote && read && back == value;
+	IOSleep(20);
+	bool read2 = !sweet_spmi_read(sweet_battery_sid, kChgRegs[index], &later);
+	IOLog("SWEET BATT: write %#06x <- %#x: %s, arbiter status %#x after %u %s; read back %#x%s, 20 ms later %#x%s\n",
+	    kChgRegs[index], value, rc == 0 ? "sent" : "NOT sent (refused before the bus)", status, tries,
+	    tries == 1 ? "try" : "tries", back, read ? "" : " (failed)", later, read2 ? "" : " (failed)");
+	chargeDump(rc == 0 ? "after the write" : "write refused");
+	return rc == 0 && read && read2 && later == value;
 }
 
