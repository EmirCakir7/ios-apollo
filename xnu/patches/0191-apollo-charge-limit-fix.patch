 /* apollo (xnu 0190): write one of kChgRegs (by index), read it back, log both; true if it reads back as written */
+/*
+ * xnu 0191: the four registers apollo_chg writes and what the charger says it does with them (read only: DCDC
+ * ICL_MAX_STATUS 0x1106, ICL_STATUS 0x1107 = the limit in force, AICL_ICL_STATUS 0x1108, AICL_STATUS 0x110a, and
+ * USBIN_CMD_IL 0x1340, whose bit 0 is "input suspended"); "??" for a byte that could not be read.
+ */
+void
+SweetBattery::chargeDump(const char *when)
+{
+	static const unsigned regs[] = {0x1370, 0x1366, 0x1342, 0x1365, 0x1106, 0x1107, 0x1108, 0x110a, 0x1340};
+	char line[160];
+	unsigned at = 0;
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]) && at + 12 < sizeof(line); ++i) {
+		uint8_t v = 0;
+		if (sweet_spmi_read(sweet_battery_sid, regs[i], &v)) {
+			at += (unsigned)snprintf(line + at, sizeof(line) - at, " %04x=??", regs[i]);
+		} else {
+			at += (unsigned)snprintf(line + at, sizeof(line) - at, " %04x=%02x", regs[i], v);
+		}
+	}
+	IOLog("SWEET BATT: charger registers (%s):%s\n", when, line);
+}
