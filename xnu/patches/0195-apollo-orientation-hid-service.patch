+/*
+ * (xnu 0195) A motion coprocessor's events carry the sample's sensor time in a child event:
+ * CoreLocation's sensorTimeFromHidChildEvent() (locationd, backboardd) takes the first child's 8-byte
+ * payload when it is vendor-defined with page 0xff15 usage 2 ("Event has no children" / "no timestamp"
+ * otherwise, and the event is dropped as stale @ 0). Times must increase.
+ */
+static void
+sweet_add_sensor_time(IOHIDEvent *e, uint64_t ts)
+{
+	IOHIDEvent *child = IOHIDEvent::vendorDefinedEvent(ts, 0xff15, 2, 0, (UInt8 *)&ts, sizeof(ts));
+	if (child) {
+		e->appendChild(child);
+		child->release();
+	}
+}
