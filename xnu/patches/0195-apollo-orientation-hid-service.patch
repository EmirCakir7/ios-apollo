+bool
+SweetHIDMotion::open(IOService *client, IOOptionBits options, void *context, Action action)
+{
+	bool ok = IOHIDEventService::open(client, options, context, action);
+
+	if (ok && fTimer) {
+		/* a client that has just opened gets the current value at once, whatever the interval */
+		fPoke = true;
+		fTimer->setTimeoutMS(100);
+	}
+	return ok;
+}
+
+IOHIDEvent *
+SweetHIDMotion::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return type == sweetEventType() ? makeEvent(mach_absolute_time()) : NULL;
+}
