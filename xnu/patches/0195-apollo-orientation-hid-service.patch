+/*
+ * (xnu 0195) SweetHIDOrientation: the device orientation the way a motion coprocessor reports it. Raw
+ * accel/gyro alone never rotated the screen (locationd's own detector wants more; backboardd's HID system
+ * takes ready-made orientations, hidSystem:receivedUpdatedDeviceOrientation:). A Device Orientation
+ * collection (Sensor page 0x20, usage 0x8A) whose events are kIOHIDEventTypeOrientation of type CMUsage
+ * carrying an AppleVendorMotion (0xff0c) usage: 0x64 ambiguous, 0x65 portrait, 0x66 upside down,
+ * 0x67 landscape left, 0x68 landscape right, 0x69 face up, 0x6a face down, each with the sensor-time child
+ * event. The orientation comes from the gravity vector the accelerometer reports (milli-g): the axis that
+ * leads the others by 200 decides: x < 0 landscape left, x > 0 landscape right, y < 0 portrait, y > 0
+ * upside down, z < 0 face up, z > 0 face down; otherwise ambiguous. Needs bit 4 of sweetmotion_mask
+ * (e.g. 0x13 = accel + gyro + orientation).
+ */
+enum {
+	kSweetOrientAmbiguous = 0x64, kSweetOrientPortrait, kSweetOrientUpsideDown, kSweetOrientLandscapeLeft,
+	kSweetOrientLandscapeRight, kSweetOrientFaceUp, kSweetOrientFaceDown,
+};
+
+static UInt32
+sweet_orientation_of(int x, int y, int z)
+{
+	int ax = x < 0 ? -x : x, ay = y < 0 ? -y : y, az = z < 0 ? -z : z;
+	if (ax > ay + 200 && ax > az + 200) {
+		return x < 0 ? kSweetOrientLandscapeLeft : kSweetOrientLandscapeRight;
+	}
+	if (ay > ax + 200 && ay > az + 200) {
+		return y < 0 ? kSweetOrientPortrait : kSweetOrientUpsideDown;
+	}
+	if (az > ax + 200 && az > ay + 200) {
+		return z < 0 ? kSweetOrientFaceUp : kSweetOrientFaceDown;
+	}
+	return kSweetOrientAmbiguous;
+}
+
+#define SWEET_ORIENT_RESEND_US 1000000
+#define SWEET_ORIENT_LOG_US    10000000
+
+class SweetHIDOrientation : public SweetHIDMotion {
+	OSDeclareDefaultStructors(SweetHIDOrientation);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0x20; }       /* kHIDPage_Sensor */
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 0x8a; }           /* Orientation: Device Orientation */
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 5; }
+	virtual IOHIDEventType sweetEventType() APPLE_KEXT_OVERRIDE { return kIOHIDEventTypeOrientation; }
+	virtual IOHIDEvent *makeEvent(uint64_t now) APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEvent *nextEvent(uint64_t now, UInt32 us) APPLE_KEXT_OVERRIDE;
+private:
+	UInt32 fUsage;          /* derived orientation of the last event */
+	uint64_t fLastTs;       /* sensor times must increase */
+	UInt32 fSinceSendUs;    /* time since the last event of a tick */
+	UInt32 fSinceLogUs;
+	UInt32 fSent;
+	bool fSentAny;
+};
+OSDefineMetaClassAndStructors(SweetHIDOrientation, SweetHIDMotion);
+
+IOHIDEvent *
+SweetHIDOrientation::makeEvent(uint64_t now)
+{
+	if (now <= fLastTs) {
+		now = fLastTs + 1;
+	}
+	fLastTs = now;
+	fUsage = sweet_orientation_of(gSweetGravity[0], gSweetGravity[1], gSweetGravity[2]);
+	IOHIDEvent *e = IOHIDEvent::orientationEvent(now, kIOHIDOrientationTypeCMUsage);
+	if (e) {
+		e->setIntegerValue(kIOHIDEventFieldOrientationDeviceOrientationUsage, (SInt32)fUsage);
+		sweet_add_sensor_time(e, now);
+		fSent++;
+	}
+	return e;
+}
+
+IOHIDEvent *
+SweetHIDOrientation::nextEvent(uint64_t now, UInt32 us)
+{
+	UInt32 usage = sweet_orientation_of(gSweetGravity[0], gSweetGravity[1], gSweetGravity[2]);
+	bool changed = !fSentAny || usage != fUsage;
+
+	fSinceSendUs += us;
+	fSinceLogUs += us;
+	if (fSinceLogUs >= SWEET_ORIENT_LOG_US) {
+		fSinceLogUs = 0;
+		IOLog("SWEET HID: SweetHIDOrientation orientation 0x%x, %u events sent, %u clients\n", (unsigned)usage,
+		    (unsigned)fSent, _clients ? (unsigned)_clients->getCount() : 0);
+	}
+	/* the first event, a change, an open (us == 0) and then every second */
+	if (!changed && us != 0 && fSinceSendUs < SWEET_ORIENT_RESEND_US) {
+		return NULL;
+	}
+	if (changed && fSentAny) {
+		IOLog("SWEET HID: SweetHIDOrientation orientation now 0x%x\n", (unsigned)usage);
+	}
+	fSentAny = true;
+	fSinceSendUs = 0;
+	return makeEvent(now);
+}
