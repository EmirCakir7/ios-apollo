+/*
+ * apollo (Xiaomi Mi 10T / SM8250): camera, step 4 of the bring-up: a READ-ONLY look at the camera PMIC (pm8008) over I2C.
+ *
+ * Does NOTHING without the option apollo_i2c_pm8008=1 (apollo_option(): a boot-arg, else the ADT /sweet-options, as mkadt.py --option
+ * writes it).  With it, after apollo_i2c_pm8008_delay seconds (default 25), on a thread of its own:
+ *
+ *   1  map the TLMM south tile (gpio48/49), the TLMM north tile (gpio77), the GCC and the serial engine
+ *   2  READ the level of gpio77, the pm8008 chip enable.  LOW: log it and stop.  This file never drives gpio77 and never enables the chip.
+ *   3  read the levels of gpio48/49 (the I2C lines); a line that is low: log it and stop
+ *   4  GCC: the QUP wrapper 2 AHB and core clocks and the SE16 clock (the votes Linux's gcc-sm8250.c lists) on, the SE16 root to 19.2 MHz
+ *      when it is not in DFS mode; gpio48/49 to function qup16
+ *   5  GENI I2C, FIFO mode, polled, 100 kHz; the SE must already hold the I2C firmware (this file loads none)
+ *   6  reads only: one register pointer write (2 address bytes) then one data byte read, per register; slave 0x08 (misc) and 0x09
+ *      (regulators).  No data byte is ever written to a slave.  Each transaction is bounded to 100 ms; a NACK or a timeout runs the
+ *      GENI cancel/abort sequence, so the bus is released.  A first read that is not acknowledged: logged, stop.
+ *   7  everything undone in reverse: the SE registers, the pin function of gpio48/49, the clock votes, the root clock generator
+ *
+ * Not touched, ever, by this file: gpio77 and the rest of the north tile (read only), any regulator or rail, the pm8008's own registers
+ * (no write to slave 0x08 or 0x09 but the two register-address bytes that every read starts with), any other I2C slave, the SPMI bus.
+ *
+ * Protocol reference: Linux drivers/i2c/busses/i2c-qcom-geni.c and drivers/soc/qcom/qcom-geni-se.c (v7.0.14), the register map in
+ * include/linux/soc/qcom/geni-se.h, the clocks in drivers/clk/qcom/gcc-sm8250.c.  The sequence below is written from the register
+ * description, in the style of the verified GENI I2C setup of bsd/dev/sweet_touch.c (xnu 0060/0063).
+ *
+ * Every line starts "SWEET I2C:" and goes to the loader's log BEFORE the step it announces, so a hang shows where it was.  Then 12 s
+ * of sleep (the kernel log goes to disk every 10 s) and the thread ends.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+extern int apollo_option(const char *name, int fallback);       /* bsd/dev/apollo_pmic.c (xnu 0181): a boot-arg, else the ADT /sweet-options */
+extern lck_mtx_t apollo_say_lock;       /* sweet_adsp.c's: the log's line lock */
+
+#define TLMM_SOUTH_PA           0x0f500000u     /* gpio48/49 (qup16) */
+#define TLMM_NORTH_PA           0x0f900000u     /* gpio77 (pm8008 chip enable): read only */
+#define TLMM_TILE_SIZE          0x00067000u     /* gpio0..102 of one tile, 0x1000 each */
+#define TLMM_GPIO_CFG(n)        (0x1000u * (n))
+#define TLMM_GPIO_IN_OUT(n)     (0x1000u * (n) + 0x4u)
+#define PIN_SDA                 48u             /* qup16 function 1, south tile (Linux pinctrl-sm8250.c) */
+#define PIN_SCL                 49u
+#define PIN_PM8008_EN           77u
+#define PIN_FUNC_MASK           (0xfu << 2)
+#define PIN_FUNC_QUP16          (1u << 2)
+
+#define GCC_PA                  0x00100000u
+#define GCC_SIZE                0x00060000u
+#define GCC_VOTE                0x52010u        /* the apps vote register of QUP wrapper 2 (gcc-sm8250.c) */
+#define VOTE_CORE               (1u << 0)
+#define VOTE_S_AHB              (1u << 1)
+#define VOTE_M_AHB              (1u << 2)
+#define VOTE_CORE_2X            (1u << 3)
+#define VOTE_SE16               (1u << 6)       /* gcc_qupv3_wrap2_s2_clk: the engine at 0x888000 */
+#define VOTE_MASK               (VOTE_CORE | VOTE_S_AHB | VOTE_M_AHB | VOTE_CORE_2X | VOTE_SE16)
+#define GCC_HALT_M_AHB          0x1e004u
+#define GCC_HALT_S_AHB          0x1e008u
+#define GCC_HALT_SE16           0x1e26cu
+#define GCC_HALT_CORE           0x23270u
+#define GCC_HALT_CORE_2X        0x23278u
+#define GCC_SE16_RCG            0x1e270u        /* gcc_qupv3_wrap2_s2_clk_src: CMD at +0, CFG at +4, DFS enable at +0x14, levels at +0x1c */
+#define RCG_UPDATE              (1u << 0)
+#define RCG_CFG_MASK            0x371fu         /* source, mode, divider */
+#define BRANCH_OFF              (1u << 31)
+
+#define SE_PA                   0x00888000u     /* i2c@888000 = SE16 of the QUP wrapper at 0x8c0000 */
+#define SE_SIZE                 0x00004000u
+#define SE_FORCE_DEFAULT        0x20u
+#define SE_OUTPUT_CTRL          0x24u
+#define SE_CGC_CTRL             0x28u
+#define SE_STATUS               0x40u
+#define SE_M_CLK_CFG            0x48u
+#define SE_IF_DISABLE           0x64u
+#define SE_FW_REVISION          0x68u
+#define SE_CLK_SEL              0x7cu
+#define SE_BYTE_GRAN            0x254u
+#define SE_DMA_MODE_EN          0x258u
+#define SE_TX_PACK0             0x260u
+#define SE_TX_PACK1             0x264u
+#define SE_TX_TRANS_LEN         0x26cu
+#define SE_RX_TRANS_LEN         0x270u
+#define SE_SCL_COUNTERS         0x278u
+#define SE_RX_PACK0             0x284u
+#define SE_RX_PACK1             0x288u
+#define SE_M_CMD0               0x600u
+#define SE_M_CMD_CTRL           0x604u
+#define SE_M_IRQ_STATUS         0x610u
+#define SE_M_IRQ_EN             0x614u
+#define SE_M_IRQ_CLR            0x618u
+#define SE_S_IRQ_EN             0x644u
+#define SE_S_IRQ_CLR            0x648u
+#define SE_TX_FIFO              0x700u
+#define SE_RX_FIFO              0x780u
+#define SE_TX_FIFO_STATUS       0x800u
+#define SE_RX_FIFO_STATUS       0x804u
+#define SE_TX_WATERMARK         0x80cu
+#define SE_RX_WATERMARK         0x810u
+#define SE_RX_RFR_WATERMARK     0x814u
+#define SE_IOS                  0x908u
+#define SE_GSI_EVENT_EN         0xe18u
+#define SE_IRQ_EN               0xe1cu
+#define SE_HW_PARAM_0           0xe24u
+#define SE_HW_PARAM_1           0xe28u
+#define SE_DMA_GENERAL_CFG      0xe30u
+
+#define GENI_PROTO_I2C          3u
+#define M_CMD_ACTIVE            (1u << 0)
+#define M_IRQ_DONE              (1u << 0)
+#define M_IRQ_CANCEL            (1u << 4)
+#define M_IRQ_ABORT             (1u << 5)
+#define M_IRQ_NACK              (1u << 10)      /* GP_IRQ_1: the slave did not acknowledge */
+#define M_IRQ_RX_WM             (1u << 26)
+#define M_IRQ_RX_LAST           (1u << 27)
+#define M_IRQ_TX_WM             (1u << 30)
+#define M_IRQ_ERRORS            (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) | (3u << 24) | (3u << 28))
+#define M_IRQ_EVENTS            (M_IRQ_DONE | M_IRQ_ERRORS | M_IRQ_RX_WM | M_IRQ_RX_LAST | M_IRQ_TX_WM)
+#define M_CTRL_ABORT            (1u << 1)
+#define M_CTRL_CANCEL           (1u << 2)
+#define I2C_OP_WRITE            1u
+#define I2C_OP_READ             2u
+#define I2C_PARAM_STOP_STRETCH  (1u << 2)       /* no STOP after this message: the next one starts with a repeated START */
+#define PACK_CFG0               0x0007f8feu     /* 8 bit words, 4 per FIFO word, MSB first on the wire, first byte in the low FIFO byte */
+#define PACK_CFG1               0x000ffefeu
+/* 100 kHz from the 19.2 MHz XO (the standard-mode row of Linux's table for that clock): divider 7, high 10, low 12, cycle 26 */
+#define I2C_CLK_DIV             7u
+#define I2C_SCL_COUNTERS        ((10u << 20) | (12u << 10) | 26u)
+
+#define XFER_TIMEOUT_US         100000u         /* one I2C transaction */
+
+static uint32_t delay_seconds = 25;
+
+static void
+say_line(const char *line)
+{
+	lck_mtx_lock(&apollo_say_lock);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	lck_mtx_unlock(&apollo_say_lock);
+}
+
+static void say(const char *format, ...) __printflike(1, 2);
+
+static void
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	say_line(line);
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]\n dsb sy" : : "r" (value), "r" (address) : "memory");
+}
+
+static vm_offset_t south, north, gcc, se;
+static bool bus_dead;
+
+/* ---- the undo list: each register that was changed, with what it held before -------------------------- */
+struct undo {
+	vm_offset_t base;
+	uint32_t offset, original, mask;
+};
+static struct undo undo_list[24];
+static unsigned undo_count;
+
+/* Write (value & mask) into the register, remembering what was there. */
+static void
+change(vm_offset_t base, uint32_t offset, uint32_t value, uint32_t mask)
+{
+	uint32_t before = rd(base + offset);
+
+	if (undo_count < sizeof(undo_list) / sizeof(undo_list[0])) {
+		undo_list[undo_count].base = base;
+		undo_list[undo_count].offset = offset;
+		undo_list[undo_count].original = before;
+		undo_list[undo_count].mask = mask;
+		undo_count++;
+	}
+	wr(base + offset, (before & ~mask) | (value & mask));
+}
+
+/* Wait until (register & mask) == wanted; microseconds; returns the last value read. */
+static bool
+poll(vm_offset_t address, uint32_t mask, uint32_t wanted, uint32_t us, uint32_t *last)
+{
+	uint64_t end = now_us() + us;
+	uint32_t value;
+
+	for (;;) {
+		value = rd(address);
+		if ((value & mask) == wanted) {
+			*last = value;
+			return true;
+		}
+		if (now_us() > end) {
+			*last = value;
+			return false;
+		}
+		sleep_us(2);
+	}
+}
+
+/* Wait until any bit of mask is set. */
+static bool
+poll_any(vm_offset_t address, uint32_t mask, uint32_t us, uint32_t *last)
+{
+	uint64_t end = now_us() + us;
+	uint32_t value;
+
+	for (;;) {
+		value = rd(address);
+		if ((value & mask) != 0) {
+			*last = value;
+			return true;
+		}
+		if (now_us() > end) {
+			*last = value;
+			return false;
+		}
+		sleep_us(5);
+	}
+}
+
+static void
+undo_all(void)
+{
+	uint32_t value;
+
+	say("SWEET I2C: undoing %u register changes, last first\n", undo_count);
+	while (undo_count > 0) {
+		struct undo *u = &undo_list[--undo_count];
+		uint32_t now = rd(u->base + u->offset);
+
+		wr(u->base + u->offset, (now & ~u->mask) | (u->original & u->mask));
+		if (u->base == gcc && u->offset == GCC_SE16_RCG + 4) {
+			wr(gcc + GCC_SE16_RCG, rd(gcc + GCC_SE16_RCG) | RCG_UPDATE);
+			(void)poll(gcc + GCC_SE16_RCG, RCG_UPDATE, 0, 500, &value);
+		}
+	}
+}
+
+/* ---- GENI cancel / abort: the way out of a transaction that is stuck or was not acknowledged ---------- */
+static void
+geni_release(const char *why)
+{
+	uint32_t irq = 0, status = 0;
+	bool idle;
+	unsigned words;
+
+	say("SWEET I2C: %s: GENI cancel (status %#x irq %#x)\n", why, rd(se + SE_STATUS), rd(se + SE_M_IRQ_STATUS));
+	wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+	wr(se + SE_M_CMD_CTRL, M_CTRL_CANCEL);
+	(void)poll_any(se + SE_M_IRQ_STATUS, M_IRQ_CANCEL | M_IRQ_ABORT | M_IRQ_DONE, 10000, &irq);
+	idle = poll(se + SE_STATUS, M_CMD_ACTIVE, 0, 5000, &status);
+	if (!idle) {
+		say("SWEET I2C: still busy after cancel (status %#x irq %#x): GENI abort\n", status, irq);
+		wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+		wr(se + SE_M_CMD_CTRL, M_CTRL_ABORT);
+		(void)poll_any(se + SE_M_IRQ_STATUS, M_IRQ_ABORT | M_IRQ_DONE, 10000, &irq);
+		idle = poll(se + SE_STATUS, M_CMD_ACTIVE, 0, 5000, &status);
+	}
+	/* the receive FIFO may hold bytes of the aborted read: drain it, bounded */
+	for (words = 0; words < 64 && (rd(se + SE_RX_FIFO_STATUS) & 0x1ffffffu) != 0; words++) {
+		(void)rd(se + SE_RX_FIFO);
+	}
+	wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+	if (!idle || (rd(se + SE_TX_FIFO_STATUS) & 0xfffffffu) != 0 || (rd(se + SE_RX_FIFO_STATUS) & 0x1ffffffu) != 0) {
+		bus_dead = true;
+		say("SWEET I2C: the engine did not come back to idle (status %#x tx %#x rx %#x): no more transactions\n", rd(se + SE_STATUS),
+		    rd(se + SE_TX_FIFO_STATUS), rd(se + SE_RX_FIFO_STATUS));
+	}
+}
+
+/*
+ * One GENI message in FIFO mode: a write of nt <= 4 bytes, or a read of nr <= 4 bytes, never both.  Returns 0, ENXIO (not acknowledged),
+ * EIO or ETIMEDOUT; the transaction is over, or released, when it returns.
+ */
+static int
+geni_msg(uint32_t slave, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	uint32_t irq = 0, status, word;
+	uint64_t end;
+	unsigned sent = 0, got = 0, count, j;
+	int err = ETIMEDOUT;
+
+	if (bus_dead || nt > 4 || nr > 4 || (nt != 0) == (nr != 0)) {
+		return EIO;
+	}
+	if (!poll(se + SE_STATUS, M_CMD_ACTIVE, 0, 20000, &status)) {
+		bus_dead = true;
+		say("SWEET I2C: the engine is busy before the transaction (status %#x): no more transactions\n", status);
+		return EBUSY;
+	}
+	wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+	wr(se + SE_TX_WATERMARK, nt != 0 ? 1u : 0u);
+	wr(se + (nr != 0 ? SE_RX_TRANS_LEN : SE_TX_TRANS_LEN), nr != 0 ? nr : nt);
+	wr(se + SE_M_CMD0, ((nr != 0 ? I2C_OP_READ : I2C_OP_WRITE) << 27) | (slave << 9) | (stretch ? I2C_PARAM_STOP_STRETCH : 0u));
+	end = now_us() + XFER_TIMEOUT_US;
+	for (;;) {
+		irq = rd(se + SE_M_IRQ_STATUS);
+		if ((irq & M_IRQ_ERRORS) != 0) {
+			err = (irq & M_IRQ_NACK) != 0 ? ENXIO : EIO;
+			/* a NACK is a completed command with an error: wait for its DONE, then the engine is idle again */
+			if (poll_any(se + SE_M_IRQ_STATUS, M_IRQ_DONE, 5000, &irq) && !(rd(se + SE_STATUS) & M_CMD_ACTIVE) &&
+			    (rd(se + SE_TX_FIFO_STATUS) & 0xfffffffu) == 0 && (rd(se + SE_RX_FIFO_STATUS) & 0x1ffffffu) == 0) {
+				wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+				return err;
+			}
+			break;
+		}
+		if (nt != 0 && sent == 0 && (irq & M_IRQ_TX_WM) != 0) {
+			word = 0;
+			for (j = 0; j < nt; j++) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(se + SE_TX_FIFO, word);
+			sent = nt;
+		}
+		count = rd(se + SE_RX_FIFO_STATUS) & 0x1ffffffu;
+		if (count > 64) {
+			err = EIO;
+			break;
+		}
+		while (count-- > 0) {
+			word = rd(se + SE_RX_FIFO);
+			for (j = 0; j < 4 && got < nr; j++) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is looked at after the receive FIFO was drained, so the last short word is not lost */
+		if ((irq & M_IRQ_DONE) != 0) {
+			wr(se + SE_M_IRQ_CLR, irq);
+			if (got == nr && sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		wr(se + SE_M_IRQ_CLR, irq & (M_IRQ_RX_WM | M_IRQ_RX_LAST | M_IRQ_TX_WM));
+		if (now_us() > end) {
+			err = ETIMEDOUT;
+			break;
+		}
+		sleep_us(10);
+	}
+	geni_release(err == ETIMEDOUT ? "transaction timed out (100 ms)" : "transaction failed");
+	return err;
+}
+
+/* One register read: the two address bytes (big endian, pm8008 has 16 bit registers), a repeated START, one data byte. */
+static int
+i2c_read_reg(uint32_t slave, uint32_t reg, uint8_t *value)
+{
+	uint8_t pointer[2];
+	int err;
+
+	pointer[0] = (uint8_t)(reg >> 8);
+	pointer[1] = (uint8_t)reg;
+	err = geni_msg(slave, pointer, 2, NULL, 0, true);
+	if (err != 0) {
+		return err;
+	}
+	return geni_msg(slave, NULL, 0, value, 1, false);
+}
+
+/* ---- the clocks and the pins -------------------------------------------------------------------------- */
+static bool
+clocks_on(int *clk_sel)
+{
+	static const struct {
+		uint32_t halt;
+		const char *name;
+	} branches[] = {
+		{ GCC_HALT_M_AHB, "gcc_qupv3_wrap_2_m_ahb_clk" },
+		{ GCC_HALT_S_AHB, "gcc_qupv3_wrap_2_s_ahb_clk" },
+		{ GCC_HALT_CORE, "gcc_qupv3_wrap2_core_clk" },
+		{ GCC_HALT_CORE_2X, "gcc_qupv3_wrap2_core_2x_clk" },
+		{ GCC_HALT_SE16, "gcc_qupv3_wrap2_s2_clk (SE16)" },
+	};
+	uint32_t dfs, cfg, level_cfg, value;
+	int level = -1;
+	bool ok = true;
+
+	say("SWEET I2C: SE16 root clock generator (%#x): CMD %#x CFG %#x DFS %#x; clock votes %#x\n", GCC_SE16_RCG, rd(gcc + GCC_SE16_RCG),
+	    rd(gcc + GCC_SE16_RCG + 4), rd(gcc + GCC_SE16_RCG + 0x14), rd(gcc + GCC_VOTE));
+	dfs = rd(gcc + GCC_SE16_RCG + 0x14);
+	cfg = rd(gcc + GCC_SE16_RCG + 4);
+	if ((dfs & 1u) != 0) {
+		/* the DFS levels are not altered: take the one that is the XO divided by one, as SE_GENI_CLK_SEL */
+		for (unsigned l = 0; l < 8; l++) {
+			level_cfg = rd(gcc + GCC_SE16_RCG + 0x1c + 4u * l);
+			say("SWEET I2C: DFS level %u CFG %#x\n", l, level_cfg);
+			if (level < 0 && (level_cfg & RCG_CFG_MASK) == 1u) {
+				level = (int)l;
+			}
+		}
+		if (level < 0) {
+			say("SWEET I2C: no XO/1 DFS level for SE16: no safe 19.2 MHz clock, stopping\n");
+			return false;
+		}
+	} else {
+		/* XO (source 0), divider 1: 19.2 MHz, no PLL, no voltage change; the CFG is put back by the undo */
+		change(gcc, GCC_SE16_RCG + 4, 1u, RCG_CFG_MASK);
+		wr(gcc + GCC_SE16_RCG, rd(gcc + GCC_SE16_RCG) | RCG_UPDATE);
+		if (!poll(gcc + GCC_SE16_RCG, RCG_UPDATE, 0, 500, &value)) {
+			say("SWEET I2C: SE16 root clock UPDATE bit stuck (%#x, CFG was %#x), stopping\n", value, cfg);
+			return false;
+		}
+		level = 0;
+	}
+	say("SWEET I2C: voting the QUP wrapper 2 clocks and the SE16 clock on (mask %#x)\n", VOTE_MASK);
+	change(gcc, GCC_VOTE, VOTE_MASK, VOTE_MASK);
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); i++) {
+		bool on = poll(gcc + branches[i].halt, BRANCH_OFF, 0, 1000, &value);
+
+		say("SWEET I2C: %s (%#x): %#x (%s)\n", branches[i].name, branches[i].halt, value, on ? "running" : "STILL HALTED after 1 ms");
+		ok = ok && on;
+	}
+	*clk_sel = level;
+	return ok;
+}
+
+static void
+pins_to_qup16(void)
+{
+	for (unsigned pin = PIN_SDA; pin <= PIN_SCL; pin++) {
+		uint32_t before = rd(south + TLMM_GPIO_CFG(pin));
+
+		/* only the function field: the pull, the drive strength and the output enable stay as they are; the undo puts it back */
+		change(south, TLMM_GPIO_CFG(pin), PIN_FUNC_QUP16, PIN_FUNC_MASK);
+		say("SWEET I2C: gpio%u CFG %#x -> %#x (function qup16)\n", pin, before, rd(south + TLMM_GPIO_CFG(pin)));
+	}
+}
+
+/* ---- the serial engine --------------------------------------------------------------------------------- */
+static bool
+se_setup(int clk_sel)
+{
+	uint32_t fw = rd(se + SE_FW_REVISION), tx = rd(se + SE_HW_PARAM_0), rx = rd(se + SE_HW_PARAM_1);
+
+	say("SWEET I2C: SE16 fw %#x protocol %u, status %#x, IF_DISABLE %#x, HW_PARAM_0 %#x HW_PARAM_1 %#x, IOS %#x\n", fw, (fw >> 8) & 0xffu,
+	    rd(se + SE_STATUS), rd(se + SE_IF_DISABLE), tx, rx, rd(se + SE_IOS));
+	if (((fw >> 8) & 0xffu) != GENI_PROTO_I2C) {
+		say("SWEET I2C: SE16 does not hold the I2C firmware (protocol %u, I2C is %u); this file loads no firmware, stopping\n", (fw >> 8) & 0xffu,
+		    GENI_PROTO_I2C);
+		return false;
+	}
+	if ((rd(se + SE_IF_DISABLE) & 1u) != 0 || ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u || ((tx >> 16) & 0x3fu) < 2u ||
+	    ((rx >> 16) & 0x3fu) < 2u) {
+		say("SWEET I2C: SE16 has no usable FIFO (GPI DMA only, or not 32 bit wide), stopping\n");
+		return false;
+	}
+	if ((rd(se + SE_STATUS) & 0x1001u) != 0) {
+		say("SWEET I2C: SE16 is busy already (status %#x), stopping\n", rd(se + SE_STATUS));
+		return false;
+	}
+	change(se, SE_GSI_EVENT_EN, 0, 0xffffffffu);            /* no GSI events */
+	change(se, SE_IRQ_EN, 0, 0xffffffffu);                  /* no interrupt line: the status is polled */
+	change(se, SE_S_IRQ_EN, 0, 0xffffffffu);
+	wr(se + SE_M_IRQ_CLR, 0xffffffffu);
+	wr(se + SE_S_IRQ_CLR, 0xffffffffu);
+	change(se, SE_DMA_MODE_EN, 0, 0xffffffffu);             /* FIFO mode */
+	change(se, SE_CGC_CTRL, 0x7fu, 0x7fu);
+	change(se, SE_DMA_GENERAL_CFG, 0xfu, 0xfu);
+	change(se, SE_OUTPUT_CTRL, 0x7fu, 0xffffffffu);
+	wr(se + SE_FORCE_DEFAULT, 1u);
+	change(se, SE_CLK_SEL, (uint32_t)clk_sel, 0xffffffffu);
+	change(se, SE_M_CLK_CFG, (I2C_CLK_DIV << 4) | 1u, 0xffffffffu);
+	wr(se + SE_SCL_COUNTERS, I2C_SCL_COUNTERS);
+	wr(se + SE_BYTE_GRAN, 0);
+	wr(se + SE_TX_PACK0, PACK_CFG0);
+	wr(se + SE_TX_PACK1, PACK_CFG1);
+	wr(se + SE_RX_PACK0, PACK_CFG0);
+	wr(se + SE_RX_PACK1, PACK_CFG1);
+	wr(se + SE_TX_WATERMARK, 1u);
+	wr(se + SE_RX_WATERMARK, 0);
+	wr(se + SE_RX_RFR_WATERMARK, ((rx >> 16) & 0x3fu) - 1u);
+	change(se, SE_M_IRQ_EN, M_IRQ_EVENTS, 0xffffffffu);
+	if ((rd(se + SE_TX_FIFO_STATUS) & 0xfffffffu) != 0 || (rd(se + SE_RX_FIFO_STATUS) & 0x1ffffffu) != 0) {
+		say("SWEET I2C: SE16 FIFOs hold data from before (tx %#x rx %#x), stopping\n", rd(se + SE_TX_FIFO_STATUS), rd(se + SE_RX_FIFO_STATUS));
+		return false;
+	}
+	say("SWEET I2C: SE16 set up: FIFO mode, polled, 100 kHz from the 19.2 MHz XO (CLK_SEL %d, M_CLK_CFG %#x, SCL counters %#x)\n", clk_sel,
+	    rd(se + SE_M_CLK_CFG), rd(se + SE_SCL_COUNTERS));
+	return true;
+}
+
+/*
+ * What is read.  The peripheral blocks of a Qualcomm PMIC start with DIG_MINOR, DIG_MAJOR, ANA_MINOR, ANA_MAJOR, TYPE, SUBTYPE at
+ * +0..+5; Linux's qcom-pm8008 names the misc block 0x900 and the regulator block of l1 is 0x4000.  The first entry decides whether the
+ * chip answers at all.  0x100.. is a guess of the chip ID block, not from Linux: it is read, never relied on.
+ */
+static const struct {
+	uint8_t slave;
+	uint16_t reg;
+	const char *name;
+} reads[] = {
+	{ 0x08, 0x0900, "misc DIG_MINOR" },
+	{ 0x08, 0x0901, "misc DIG_MAJOR" },
+	{ 0x08, 0x0902, "misc ANA_MINOR" },
+	{ 0x08, 0x0903, "misc ANA_MAJOR" },
+	{ 0x08, 0x0904, "misc TYPE" },
+	{ 0x08, 0x0905, "misc SUBTYPE" },
+	{ 0x08, 0x0950, "misc CHIP_ENABLE (read only)" },
+	{ 0x08, 0x0100, "0x100 block, byte 0 (unverified)" },
+	{ 0x08, 0x0101, "0x100 block, byte 1 (unverified)" },
+	{ 0x08, 0x0102, "0x100 block, byte 2 (unverified)" },
+	{ 0x08, 0x0103, "0x100 block, byte 3 (unverified)" },
+	{ 0x09, 0x4000, "l1 DIG_MINOR" },
+	{ 0x09, 0x4001, "l1 DIG_MAJOR" },
+	{ 0x09, 0x4004, "l1 TYPE" },
+	{ 0x09, 0x4005, "l1 SUBTYPE" },
+	{ 0x09, 0x4008, "l1 STATUS1 (bit 7 = ready)" },
+	{ 0x09, 0x4040, "l1 VSET_LB" },
+	{ 0x09, 0x4041, "l1 VSET_UB" },
+	{ 0x09, 0x4045, "l1 MODE_CTL1" },
+	{ 0x09, 0x4046, "l1 ENABLE_CTL1 (bit 7 = enabled)" },
+};
+
+static void
+read_pm8008(void)
+{
+	unsigned ok = 0, failed = 0, row;
+	uint8_t value;
+
+	for (row = 0; row < sizeof(reads) / sizeof(reads[0]); row++) {
+		int err;
+
+		if (bus_dead) {
+			say("SWEET I2C: bus unusable, stopping the reads\n");
+			break;
+		}
+		value = 0;
+		err = i2c_read_reg(reads[row].slave, reads[row].reg, &value);
+		if (err == 0) {
+			ok++;
+			say("SWEET I2C: slave 0x%02x reg 0x%04x = 0x%02x (%s)\n", reads[row].slave, reads[row].reg, value, reads[row].name);
+		} else {
+			failed++;
+			say("SWEET I2C: slave 0x%02x reg 0x%04x FAILED err %d (%s) (%s)\n", reads[row].slave, reads[row].reg, err,
+			    err == ENXIO ? "NACK" : (err == ETIMEDOUT ? "timeout" : "error"), reads[row].name);
+			if (row == 0) {
+				say("SWEET I2C: the pm8008 does not answer at slave 0x08: not powered, or not enabled; nothing is done about it (this file never enables it)\n");
+				break;
+			}
+			if (failed >= 3) {
+				say("SWEET I2C: 3 reads failed, stopping the reads\n");
+				break;
+			}
+		}
+	}
+	say("SWEET I2C: result: %u reads ok, %u failed\n", ok, failed);
+}
+
+/* a mapping that says what it is about to map and lets the line reach the disk first: the last line of a frozen run names the culprit */
+static vm_offset_t
+map_logged(const char *name, vm_offset_t pa, vm_size_t size)
+{
+	vm_offset_t va;
+
+	say("SWEET I2C: mapping %s: %#lx size %#lx\n", name, (unsigned long)pa, (unsigned long)size);
+	delay_for_interval(11, NSEC_PER_SEC);
+	va = ml_io_map(pa, size);
+	say("SWEET I2C: mapped %s at %#lx\n", name, (unsigned long)va);
+	return va;
+}
+
+static void
+i2c_steps(void)
+{
+	uint32_t enable_cfg, enable_io, sda_io, scl_io;
+	int clk_sel = 0;
+
+	say("SWEET I2C: starting; reads only, nothing is written to any slave, gpio77 and the rails are never driven\n");
+	delay_for_interval(11, NSEC_PER_SEC);       /* so that the log shows that the thread got here */
+	/* only the pages of the pins used (the large mapping of a whole tile froze the phone, see 0203): the base is kept as the tile's, so
+	 * that tile + 0x1000 * gpio still addresses the pin */
+	south = map_logged("south tlmm gpio48/49", TLMM_SOUTH_PA + 0x1000u * PIN_SDA, 0x2000);
+	north = map_logged("north tlmm gpio77", TLMM_NORTH_PA + 0x1000u * PIN_PM8008_EN, 0x1000);
+	if (south != 0) {
+		south -= 0x1000u * PIN_SDA;
+	}
+	if (north != 0) {
+		north -= 0x1000u * PIN_PM8008_EN;
+	}
+	gcc = map_logged("gcc", GCC_PA, GCC_SIZE);
+	se = map_logged("qup wrapper 2 SE16", SE_PA, SE_SIZE);
+	if (south == 0 || north == 0 || gcc == 0 || se == 0) {
+		say("SWEET I2C: FAILED to map the registers (south %lx north %lx gcc %lx se %lx); nothing done\n", (unsigned long)south, (unsigned long)north,
+		    (unsigned long)gcc, (unsigned long)se);
+		return;
+	}
+
+	say("SWEET I2C: reading gpio77\n");
+	delay_for_interval(11, NSEC_PER_SEC);
+	/* 2: the one thing read from the north tile */
+	enable_cfg = rd(north + TLMM_GPIO_CFG(PIN_PM8008_EN));
+	enable_io = rd(north + TLMM_GPIO_IN_OUT(PIN_PM8008_EN));
+	say("SWEET I2C: gpio77 (pm8008 chip enable): level %u (CFG %#x IN_OUT %#x), read only\n", enable_io & 1u, enable_cfg, enable_io);
+	if ((enable_io & 1u) == 0) {
+		say("SWEET I2C: gpio77 is LOW: the pm8008 is not enabled; stopping, nothing was touched (this file never enables the chip)\n");
+		return;
+	}
+
+	/* 3: the bus lines, read before the pin function is changed */
+	sda_io = rd(south + TLMM_GPIO_IN_OUT(PIN_SDA));
+	scl_io = rd(south + TLMM_GPIO_IN_OUT(PIN_SCL));
+	say("SWEET I2C: gpio48 (SDA) CFG %#x level %u, gpio49 (SCL) CFG %#x level %u\n", rd(south + TLMM_GPIO_CFG(PIN_SDA)), sda_io & 1u,
+	    rd(south + TLMM_GPIO_CFG(PIN_SCL)), scl_io & 1u);
+	if ((sda_io & 1u) == 0 || (scl_io & 1u) == 0) {
+		say("SWEET I2C: an I2C line is LOW (no pull-up rail, or the bus is held): stopping, nothing was touched\n");
+		return;
+	}
+
+	/* 4 */
+	if (!clocks_on(&clk_sel)) {
+		say("SWEET I2C: the SE16 clocks are not running: stopping\n");
+		goto out;
+	}
+	pins_to_qup16();
+
+	/* 5 */
+	if (!se_setup(clk_sel)) {
+		goto out;
+	}
+
+	/* 6 */
+	say("SWEET I2C: reading the pm8008 (slave 0x08 misc, slave 0x09 regulators), 100 ms per transaction\n");
+	read_pm8008();
+
+out:
+	delay_for_interval(12, NSEC_PER_SEC);       /* the kernel log goes to disk every 10 s: let the lines above reach it before the undo */
+	/* 7 */
+	say("SWEET I2C: undo\n");
+	undo_all();
+	say("SWEET I2C: after the undo: gpio48 CFG %#x gpio49 CFG %#x, clock votes %#x, SE16 root CMD %#x CFG %#x\n", rd(south + TLMM_GPIO_CFG(PIN_SDA)),
+	    rd(south + TLMM_GPIO_CFG(PIN_SCL)), rd(gcc + GCC_VOTE), rd(gcc + GCC_SE16_RCG), rd(gcc + GCC_SE16_RCG + 4));
+	say("SWEET I2C: done, everything undone\n");
+}
+
+static void
+i2c_thread(void *arg, wait_result_t wr_result)
+{
+#pragma unused(arg, wr_result)
+	if (delay_seconds > 0) {
+		delay_for_interval(delay_seconds, NSEC_PER_SEC);
+	}
+	i2c_steps();
+	if (undo_count == 0) {
+		delay_for_interval(12, NSEC_PER_SEC);   /* a run that stopped before any change still gets its lines to the disk */
+	}
+	thread_terminate(current_thread());
+}
+
+void
+apollo_i2c_pm8008_init(void);
+
+void
+apollo_i2c_pm8008_init(void)
+{
+	thread_t thread;
+
+	if (apollo_option("apollo_i2c_pm8008", 0) == 0) {
+		return;
+	}
+	delay_seconds = (uint32_t)apollo_option("apollo_i2c_pm8008_delay", (int)delay_seconds);
+	if (delay_seconds > 600) {
+		delay_seconds = 600;
+	}
+	if (kernel_thread_start(i2c_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET I2C: no thread: nothing done\n");
+		return;
+	}
+	thread_deallocate(thread);
+	printf("SWEET I2C: armed (apollo_i2c_pm8008=1): in %u s; reads only\n", delay_seconds);
+}
