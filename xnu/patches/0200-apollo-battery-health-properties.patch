+void
+SweetBattery::putString(const char *key, const char *value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSString *string = OSString::withCString(value);
+	if (symbol && string) {
+		setPSProperty(symbol, string);
+	}
+	OSSafeReleaseNULL(string);
+	OSSafeReleaseNULL(symbol);
+}
+
+/* xnu 0200: the properties powerd's Battery Health code reads, at the top and in "BatteryData" (see the header) */
+void
+SweetBattery::putHealth(unsigned percent, unsigned capacity)
+{
+	putString("Serial", kSweetBatterySerial);
+	putString("BatterySerialNumber", kSweetBatterySerial);
+	putNumber("NominalChargeCapacity", kSweetNominalMAh);
+	OSDictionary *data = OSDictionary::withCapacity(5);
+	if (data) {
+		const char *keys[] = {"CycleCount", "NominalChargeCapacity", "AppleRawMaxCapacity", "DesignCapacity", "AppleRawCurrentCapacity"};
+		UInt32 values[] = {0, kSweetNominalMAh, kSweetNominalMAh, kSweetDesignMAh, capacity};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				data->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		const OSSymbol *symbol = OSSymbol::withCString("BatteryData");
+		if (symbol) {
+			setPSProperty(symbol, data);
+			symbol->release();
+		}
+		data->release();
+	}
+	if (!fHealthSaid) {
+		fHealthSaid = true;
+		IOLog("SWEET BATT: health published: Serial \"%s\" (placeholder), DesignCapacity %u, NominalChargeCapacity %u mAh "
+		    "(Android's charge_full, not read from the gauge: %u%% of the design), CycleCount 0 (as before: the gauge's 0 "
+		    "is unreliable), MaxCapacity 100, CurrentCapacity %u%%\n", kSweetBatterySerial, kSweetDesignMAh,
+		    kSweetNominalMAh, (kSweetNominalMAh * 100u + kSweetDesignMAh - 1u) / kSweetDesignMAh, percent);
+	}
+}
