+/*
+ * apollo (Xiaomi Mi 10T / SM8250): camera, step 3 of the bring-up: a READ-ONLY survey of the power and pin state.
+ *
+ * Does NOTHING without the option apollo_cam_ro=1 (apollo_option(): a boot-arg, else the ADT /sweet-options, as mkadt.py --option
+ * writes it).  With it, after apollo_cam_ro_delay seconds (default 20), on a thread of its own, it READS and logs:
+ *
+ *   1  RPMh cmd-db (RAM, 0x80860000): the address of the camera rails' resources, if listed
+ *   2  TLMM: the CFG and IN_OUT registers of the camera pins, in the three tiles
+ *   3  PM8150L (SPMI slave 4) GPIO1: its registers (11 s after the lines above, so they are on disk if this hangs)
+ *
+ * Nothing is written to any register, GPIO, PMIC or regulator by this file; no I2C transaction of any kind; no RPMh vote; no sensor
+ * power.  The one store to MMIO is the SPMI arbiter's one-byte READ command (EXT_READL), as bsd/dev/sweet_spmi.c issues it; sweet_spmi_read()
+ * only reaches slaves 0 and 2 and a few peripherals, so this file has its own copy of that read for slave 4.
+ *
+ * Every line starts "SWEET CAM:".  Then 12 s of sleep (the kernel log goes to disk every 10 s) and the thread ends.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+extern int apollo_option(const char *name, int fallback);       /* bsd/dev/apollo_pmic.c (xnu 0181): a boot-arg, else the ADT /sweet-options */
+extern lck_mtx_t apollo_say_lock;       /* sweet_adsp.c's: the log's line lock */
+
+#define TLMM_WEST_PA            0x0f100000u
+#define TLMM_SOUTH_PA           0x0f500000u
+#define TLMM_NORTH_PA           0x0f900000u
+#define TLMM_TILE_SIZE          0x00067000u     /* gpio0..102 of one tile, 0x1000 each */
+#define TLMM_GPIO_CFG(n)        (0x1000u * (n))
+#define TLMM_GPIO_IN_OUT(n)     (0x1000u * (n) + 0x4u)
+
+#define SP_CORE_PA              0x0c440000u
+#define SP_CFG_PA               0x0c40a000u
+#define SP_OBS_PA               0x0e600000u
+#define SP_NO_APID              0xffffu
+
+#define CMD_DB_PA               0x80860000u     /* kona reserved-memory cmd_db (xnu 0101, 0126) */
+#define CMD_DB_SIZE             0x00020000u
+#define CMD_DB_DATA             144u            /* version, magic, 8 slave headers of 16 bytes, checksum, reserved */
+#define CMD_DB_ENTRY            24u             /* id[8], priority[2], addr, len.16, offset.16 */
+
+static uint32_t delay_seconds = 20;
+
+static void
+say_line(const char *line)
+{
+	lck_mtx_lock(&apollo_say_lock);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	lck_mtx_unlock(&apollo_say_lock);
+}
+
+static void say(const char *format, ...) __printflike(1, 2);
+
+static void
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	say_line(line);
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+/* ---- 1: the RPMh command database (Linux drivers/soc/qcom/cmd-db.c; as xnu 0101 reads it) ---------------------------- */
+static const volatile uint8_t *cmd_db;
+
+static uint32_t
+cmd_db_le(uint32_t at, unsigned bytes)
+{
+	uint32_t v = 0;
+
+	for (unsigned i = 0; i < bytes; ++i) {
+		v |= (uint32_t)cmd_db[at + i] << (8 * i);
+	}
+	return v;
+}
+
+/* The number of entries over all the slave headers. */
+static unsigned
+cmd_db_entry_count(void)
+{
+	unsigned total = 0;
+
+	for (uint32_t s = 0; s < 8; ++s) {
+		uint32_t slave = 8u + 16u * s;
+
+		if (cmd_db_le(slave, 2) != 0 && cmd_db_le(slave + 6, 2) <= 512) {
+			total += cmd_db_le(slave + 6, 2);
+		}
+	}
+	return total;
+}
+
+/* Does entry e's 8-byte id start with prefix (the rest of the id after it zero when exact)? */
+static bool
+cmd_db_id_is(uint32_t e, const char *name, bool exact)
+{
+	unsigned k = 0;
+
+	for (; name[k] != 0 && k < 8; ++k) {
+		if (cmd_db[e + k] != (uint8_t)name[k]) {
+			return false;
+		}
+	}
+	if (exact && k < 8 && cmd_db[e + k] != 0) {
+		return false;
+	}
+	return true;
+}
+
+/* Every entry whose id starts with prefix, as "id addr"; returns how many were printed (at most max). */
+static unsigned
+cmd_db_list(const char *prefix, unsigned max)
+{
+	unsigned shown = 0;
+
+	for (uint32_t s = 0; s < 8; ++s) {
+		uint32_t slave = 8u + 16u * s, hoff = cmd_db_le(slave + 2, 2), cnt = cmd_db_le(slave + 6, 2);
+
+		if (cmd_db_le(slave, 2) == 0 || cnt > 512) {
+			continue;
+		}
+		for (uint32_t i = 0; i < cnt && shown < max; ++i) {
+			uint32_t e = CMD_DB_DATA + hoff + CMD_DB_ENTRY * i;
+			char id[9];
+
+			if (e + CMD_DB_ENTRY > CMD_DB_SIZE || !cmd_db_id_is(e, prefix, false)) {
+				continue;
+			}
+			for (unsigned k = 0; k < 8; ++k) {
+				uint8_t c = cmd_db[e + k];
+
+				id[k] = (c >= 0x20 && c < 0x7f) ? (char)c : (c == 0 ? '\0' : '?');
+			}
+			id[8] = '\0';
+			say("SWEET CAM: cmd-db entry %s: addr %#x (slave header %u, length %u)\n", id, cmd_db_le(e + 16, 4), s, cmd_db_le(e + 20, 2));
+			shown++;
+		}
+	}
+	return shown;
+}
+
+/* The address of an exactly named resource, or 0 when it is not listed (no RPMh address is 0). */
+static uint32_t
+cmd_db_addr(const char *name)
+{
+	for (uint32_t s = 0; s < 8; ++s) {
+		uint32_t slave = 8u + 16u * s, hoff = cmd_db_le(slave + 2, 2), cnt = cmd_db_le(slave + 6, 2);
+
+		if (cmd_db_le(slave, 2) == 0 || cnt > 512) {
+			continue;
+		}
+		for (uint32_t i = 0; i < cnt; ++i) {
+			uint32_t e = CMD_DB_DATA + hoff + CMD_DB_ENTRY * i;
+
+			if (e + CMD_DB_ENTRY <= CMD_DB_SIZE && cmd_db_id_is(e, name, true)) {
+				return cmd_db_le(e + 16, 4);
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+cmd_db_survey(void)
+{
+	static const char *const wanted[] = { "smpc5", "smpc8", "ldoc1", "mmcx.lvl", "smpa5", "ldoa1", "mmcx" };
+	vm_offset_t va;
+	unsigned n, shown;
+
+	say("SWEET CAM: cmd-db: reading the RPMh command database at %#x (memory only, no vote)\n", CMD_DB_PA);
+	va = ml_io_map_wcomb(CMD_DB_PA, CMD_DB_SIZE);
+	if (va == 0) {
+		say("SWEET CAM: cmd-db: FAILED to map it\n");
+		return;
+	}
+	cmd_db = (const volatile uint8_t *)va;
+	if (cmd_db[4] != 0xdb || cmd_db[5] != 0x30 || cmd_db[6] != 0x03 || cmd_db[7] != 0x0c) {
+		say("SWEET CAM: cmd-db: no magic (version %#x, bytes %02x %02x %02x %02x): not read further\n", cmd_db_le(0, 4), cmd_db[4], cmd_db[5],
+		    cmd_db[6], cmd_db[7]);
+		return;
+	}
+	say("SWEET CAM: cmd-db: version %#x, %u entries\n", cmd_db_le(0, 4), cmd_db_entry_count());
+	for (n = 0; n < sizeof(wanted) / sizeof(wanted[0]); n++) {
+		uint32_t addr = cmd_db_addr(wanted[n]);
+
+		if (addr != 0) {
+			say("SWEET CAM: cmd-db %s: FOUND, addr %#x\n", wanted[n], addr);
+		} else {
+			say("SWEET CAM: cmd-db %s: not listed\n", wanted[n]);
+		}
+	}
+	/* what is there under the PM8150L/PM8150A/MMCX names, to see how the rails are called on this phone */
+	shown = cmd_db_list("smpc", 12) + cmd_db_list("ldoc", 16) + cmd_db_list("mmcx", 8) + cmd_db_list("smpa", 12);
+	say("SWEET CAM: cmd-db: %u entries listed (smpc*, ldoc*, mmcx*, smpa*)\n", shown);
+}
+
+/* ---- 2: the TLMM ----------------------------------------------------------------------------------------------------- */
+/* SM8250's TLMM is three tiles (west, south, north); a pin's registers are at tile + 0x1000 * gpio in its own tile and read 0 in the others
+ * (xnu 0085's finding).  CFG: pull bits 0-1, function bits 2-5, drive strength bits 6-8 ((n + 1) * 2 mA), output enable bit 9.
+ * IN_OUT (CFG + 4): input level bit 0, output level bit 1. */
+static const uint32_t pin_gpio[] = { 93, 94, 101, 102, 77, 48, 49 };
+static const char *const pin_name[] = { "CAM_RESET0", "CAM_MCLK0", "CCI0 i2c (sda)", "CCI0 i2c (scl)", "pm8008 enable", "qup16 i2c (pm8008)", "qup16 i2c (pm8008)" };
+static const char *const pull_name[4] = { "none", "pull-down", "keeper", "pull-up" };
+static const char *const tile_name[3] = { "west", "south", "north" };
+/* only the owning tile is read: reads of the other tiles at the same offset are not known to be harmless */
+static const uint8_t pin_tile[] = { 2, 2, 2, 2, 2, 1, 1 };
+
+static void
+tlmm_survey(void)
+{
+	static const uint32_t tile_pa[3] = { TLMM_WEST_PA, TLMM_SOUTH_PA, TLMM_NORTH_PA };
+	vm_offset_t tile[3];
+	unsigned t, p;
+
+	say("SWEET CAM: tlmm: reading CFG and IN_OUT of the camera pins in the west/south/north tiles (reads only)\n");
+	for (t = 0; t < 3; t++) {
+		tile[t] = ml_io_map(tile_pa[t], TLMM_TILE_SIZE);
+		if (tile[t] == 0) {
+			say("SWEET CAM: tlmm: FAILED to map the %s tile (%#x)\n", tile_name[t], tile_pa[t]);
+		}
+	}
+	for (p = 0; p < sizeof(pin_gpio) / sizeof(pin_gpio[0]); p++) {
+		uint32_t cfg[3] = { 0, 0, 0 }, io[3] = { 0, 0, 0 };
+		int pick = -1;
+
+		say("SWEET CAM: tlmm: about to read gpio%u in the %s tile\n", pin_gpio[p], tile_name[pin_tile[p]]);
+		delay_for_interval(11, NSEC_PER_SEC);   /* if the next read hangs, this is the last line in the log */
+		for (t = 0; t < 3; t++) {
+			if (tile[t] == 0 || t != pin_tile[p]) {
+				continue;
+			}
+			cfg[t] = rd(tile[t] + TLMM_GPIO_CFG(pin_gpio[p]));
+			io[t] = rd(tile[t] + TLMM_GPIO_IN_OUT(pin_gpio[p]));
+			if (pick < 0 && (cfg[t] | io[t]) != 0) {
+				pick = (int)t;
+			}
+		}
+		if (pick < 0) {
+			say("SWEET CAM: gpio%u %s: west cfg %#x io %#x south cfg %#x io %#x north cfg %#x io %#x | all zero: in no tile\n", pin_gpio[p],
+			    pin_name[p], cfg[0], io[0], cfg[1], io[1], cfg[2], io[2]);
+		} else {
+			uint32_t c = cfg[pick], i = io[pick];
+
+			say("SWEET CAM: gpio%u %s: west cfg %#x io %#x south cfg %#x io %#x north cfg %#x io %#x | tile %s func %u pull %s drive %u mA oe %u in %u out %u\n",
+			    pin_gpio[p], pin_name[p], cfg[0], io[0], cfg[1], io[1], cfg[2], io[2], tile_name[pick], (c >> 2) & 0xfu, pull_name[c & 3u],
+			    (((c >> 6) & 7u) + 1u) * 2u, (c >> 9) & 1u, i & 1u, (i >> 1) & 1u);
+		}
+	}
+}
+
+/* ---- 3: PM8150L (SPMI slave 4) GPIO1, by the SPMI arbiter's observer (as bsd/dev/sweet_spmi.c) ----------------------- */
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static unsigned sp_count;
+static bool sp_timed_out;
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = rd(base + off);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		unsigned owner;
+
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+/* One byte at (ppid, reg): 0 ok; -1 no channel; -2 the arbiter reported an error; -3 timed out (no later read is tried). */
+static int
+sp_read(unsigned ppid, unsigned reg, uint8_t *out)
+{
+	uint16_t apid = sp_find_apid(ppid);
+	unsigned off;
+	uint32_t cmd;
+
+	if (apid == SP_NO_APID) {
+		return -1;
+	}
+	if (sp_timed_out) {
+		return -3;
+	}
+	off = 0x80u * apid;
+	cmd = (1u << 27) | ((reg & 0xffu) << 4);
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd;     /* EXT_READL, BC=0: a read command; the only store in this file */
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return -2;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			return 0;
+		}
+		sleep_us(1);
+	}
+	sp_timed_out = true;
+	return -3;
+}
+
+static const char *
+hexval(char *buffer, size_t size, int error, uint8_t value)
+{
+	if (error == 0) {
+		snprintf(buffer, size, "%#x", (unsigned)value);
+	} else {
+		snprintf(buffer, size, "ERR%d", error);
+	}
+	return buffer;
+}
+
+static void
+spmi_survey(void)
+{
+	/* PMIC GPIO (Linux pinctrl-spmi-gpio.c): the controller at 0xc000, 0x100 per pin, so GPIO1 is peripheral 0xc0 */
+	static const unsigned regs[] = { 0x04, 0x05, 0x08, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46 };
+	static const char *const reg_name[] = { "type", "subtype", "status", "mode_ctl", "dig_vin", "dig_pull", "dig_in", "dig_out", "dig_out2", "en_ctl" };
+	const unsigned sid = 4, peripheral = 0xc0, ppid = (sid << 8) | peripheral;
+	uint32_t version;
+	uint16_t apid;
+	char b[10][12];
+	uint8_t v[10] = { 0 };
+	int e[10];
+	unsigned n;
+
+	say("SWEET CAM: spmi: PM8150L (slave %u) GPIO1: reading through the arbiter's observer, one byte per read\n", sid);
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000);
+	if (sp_core == 0 || sp_cfg == 0 || sp_obs == 0) {
+		say("SWEET CAM: spmi: FAILED to map the arbiter (core %lx cfg %lx obs %lx)\n", (unsigned long)sp_core, (unsigned long)sp_cfg, (unsigned long)sp_obs);
+		return;
+	}
+	version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (version < 0x50000000u || version >= 0x70000000u || sp_count == 0 || sp_count > 512) {
+		say("SWEET CAM: spmi: arbiter %#x with %u channels: not the one expected, nothing read\n", version, sp_count);
+		return;
+	}
+	apid = sp_find_apid(ppid);
+	say("SWEET CAM: spmi: arbiter %#x, %u channels; ppid %#x (slave %u, peripheral %#x): %s\n", version, sp_count, ppid, sid, peripheral,
+	    apid == SP_NO_APID ? "NO CHANNEL maps it, nothing read" : "channel found");
+	if (apid == SP_NO_APID) {
+		return;
+	}
+	say("SWEET CAM: spmi: ppid %#x is APID %u\n", ppid, (unsigned)apid);
+	for (n = 0; n < sizeof(regs) / sizeof(regs[0]); n++) {
+		e[n] = sp_read(ppid, regs[n], &v[n]);
+		hexval(b[n], sizeof(b[n]), e[n], v[n]);
+	}
+	say("SWEET CAM: pm8150l gpio1 (0xc000): %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s\n", reg_name[0], b[0], reg_name[1], b[1],
+	    reg_name[2], b[2], reg_name[3], b[3], reg_name[4], b[4], reg_name[5], b[5], reg_name[6], b[6], reg_name[7], b[7], reg_name[8], b[8],
+	    reg_name[9], b[9]);
+	if (e[0] == 0 && e[3] == 0 && e[9] == 0) {
+		say("SWEET CAM: pm8150l gpio1: mode %u (0 in, 1 out, 2 in/out, 3 analog), enabled %u, status input-level %u\n", v[3] & 3u, (v[9] >> 7) & 1u,
+		    e[2] == 0 ? (v[2] & 1u) : 2u);
+	}
+}
+
+static void
+cam_ro_steps(void)
+{
+	say("SWEET CAM: ro survey starting (apollo_cam_ro=1): reads only; nothing is written, no I2C slave is addressed, no RPMh vote, no sensor power\n");
+	delay_for_interval(11, NSEC_PER_SEC);       /* so that the log shows how far we got */
+	cmd_db_survey();
+	delay_for_interval(11, NSEC_PER_SEC);
+	tlmm_survey();
+	/* the SPMI arbiter is the part that could stall: let the lines above reach the log disk first (it is written every 10 s) */
+	delay_for_interval(11, NSEC_PER_SEC);
+	spmi_survey();
+	say("SWEET CAM: ro survey done: nothing was written\n");
+	delay_for_interval(12, NSEC_PER_SEC);       /* the lines above reach the disk */
+}
+
+static void
+cam_ro_thread(void *arg, wait_result_t wr_result)
+{
+#pragma unused(arg, wr_result)
+	if (delay_seconds > 0) {
+		delay_for_interval(delay_seconds, NSEC_PER_SEC);
+	}
+	cam_ro_steps();
+	thread_terminate(current_thread());
+}
+
+void
+apollo_cam_ro_init(void);
+
+void
+apollo_cam_ro_init(void)
+{
+	thread_t thread;
+
+	if (apollo_option("apollo_cam_ro", 0) == 0) {
+		return;
+	}
+	delay_seconds = (uint32_t)apollo_option("apollo_cam_ro_delay", (int)delay_seconds);
+	if (delay_seconds > 600) {
+		delay_seconds = 600;
+	}
+	if (kernel_thread_start(cam_ro_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET CAM: ro survey: no thread: nothing done\n");
+		return;
+	}
+	thread_deallocate(thread);
+	printf("SWEET CAM: ro survey armed (apollo_cam_ro=1): in %u s, reads only\n", delay_seconds);
+}
