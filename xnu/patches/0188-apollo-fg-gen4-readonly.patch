+/* apollo (xnu 0188): 16 raw bytes of a block from `first`, "--" where a read failed. Read only, not interpreted. */
+void
+SweetBattery::dumpWindow(unsigned base, unsigned first)
+{
+	char line[16 * 3 + 1];
+	unsigned n = 0;
+	for (unsigned i = 0; i < 16; ++i) {
+		uint8_t value;
+		if (sweet_spmi_read(sweet_battery_sid, base + first + i, &value)) {
+			n += (unsigned)snprintf(line + n, sizeof(line) - n, "-- ");
+		} else {
+			n += (unsigned)snprintf(line + n, sizeof(line) - n, "%02x ", value);
+		}
+	}
+	IOLog("SWEET BATT: SID %u %#06x: %s\n", sweet_battery_sid, base + first, line);
+}
