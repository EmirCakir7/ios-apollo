+	unsigned rpUnits;
+	const char *rp;
+	switch (snk & 0x7f) { /* DETECTED_SRC_TYPE_MASK */
+	case 0x08: /* SNK_RP_STD_BIT */
+		rpUnits = 5;
+		rp = "Rp default (USB, 500 mA)";
+		break;
+	case 0x04: /* SNK_RP_1P5_BIT */
+		rpUnits = 15;
+		rp = "Rp 1.5 A";
+		break;
+	case 0x02: /* SNK_RP_3P0_BIT */
+		rpUnits = 30;
+		rp = "Rp 3 A";
+		break;
+	default:
+		if (snk != fChgLastSnk) {
+			fChgLastSnk = snk;
+			IOLog("SWEET BATT: Type-C sink status %#x is no usable Rp: no write\n", snk);
+		}
+		return;
+	}
+	if (snk != fChgLastSnk) {
+		fChgLastSnk = snk;
+		IOLog("SWEET BATT: Type-C sink status %#x: %s%s\n", snk, rp,
+		    rpUnits == 5 ? ": the limit is cut to 500 mA, not raised" : "");
+	}
+	const unsigned units = fChgUnits < rpUnits ? fChgUnits : rpUnits;
+	const uint8_t want = (uint8_t)(units * 2); /* USBIN_CURRENT_LIMIT_CFG: 50 mA per step */
+	if (say) {
+		IOLog("SWEET BATT: charge limit: %s, apollo_chg %u -> %u mA, %#06x is %#x (want %#x)\n", rp, fChgUnits,
+		    units * 100, kChgRegs[0], cur, want);
