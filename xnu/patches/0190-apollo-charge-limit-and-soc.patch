+/* apollo (xnu 0190): the input current limit of apollo_chg; every 30 s, see the comment at the top of this file */
+void
+SweetBattery::chargeLimit(void)
+{
+	const unsigned sid = sweet_battery_sid;
+	if (!fReal || fChgUnits == 0) {
+		return;
+	}
+	if (!fChgChecked) {
+		fChgChecked = true;
+		if (sid != 2) {
+			IOLog("SWEET BATT: apollo_chg is for the PM8150B (sweetbattery_sid=2) only: no write\n");
+			fChgUnits = 0;
+			return;
+		}
+		if (!apollo_pmic_usbin_ours()) {
+			IOLog("SWEET BATT: charger channel not ours, no write\n");
+			fChgUnits = 0;
+			return;
+		}
+		IOLog("SWEET BATT: apollo_chg=%u (%u mA): no numeric battery temperature can be read here (fg-gen4 keeps it in its "
+		    "SRAM); only the charger's hot flags are watched\n", fChgUnits, fChgUnits * 100);
+		if (!fChgNoTemp) {
+			IOLog("SWEET BATT: apollo_chg needs apollo_chg_notemp=1 as well: no write\n");
+			fChgUnits = 0;
+			return;
+		}
+	}
+	if (fChgHot) {
+		return;
+	}
+	uint8_t usb = 0, snk = 0, misc = 0, therm = 0, cur = 0, opt = 0, ovr = 0, load = 0;
+	if (sweet_spmi_read(sid, kUsbinStatus, &usb) || sweet_spmi_read(sid, kSnkStatus, &snk) ||
+	    sweet_spmi_read(sid, kTypecMisc, &misc) || sweet_spmi_read(sid, kChgThermStatus, &therm) ||
+	    sweet_spmi_read(sid, kChgRegs[0], &cur) || sweet_spmi_read(sid, kChgRegs[1], &opt) ||
+	    sweet_spmi_read(sid, kChgRegs[2], &ovr) || sweet_spmi_read(sid, kChgRegs[3], &load)) {
+		if (!fChgReadSaid) {
+			fChgReadSaid = true;
+			IOLog("SWEET BATT: apollo_chg: a charger register could not be read: no write\n");
+		}
+		return;
+	}
+	bool say = (fChgTicks++ % 10) == 0;
+	if (therm & 0x2a) { /* BAT_TEMP_STATUS_HOT_SOFT_BIT | TOO_HOT_BIT | TOO_HOT_AFP_BIT */
+		chargeRestore("battery hot");
+		fChgHot = true;
+		IOLog("SWEET BATT: the charger reports the battery hot (%#x): apollo_chg is off until the next boot\n", therm);
+		return;
+	}
+	bool present = (usb & 0x10) != 0;                       /* USBIN_PLUGIN_RT_STS_BIT */
+	bool attached = (misc & 0x01) != 0 && !(misc & 0x40);   /* CC_ATTACHED_BIT, and not SNK_SRC_MODE_BIT: we are the sink */
+	if (!present || !attached) {
+		chargeRestore("no charger attached");
+		fChgLastSnk = ~0u;
+		return;
+	}
