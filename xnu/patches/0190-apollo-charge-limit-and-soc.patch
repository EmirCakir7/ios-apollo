+/* ---- the charger's USB input current limit (xnu 0190) ------------------------------------------------- */
+
+/*
+ * The PM8150B's smb5 USBIN peripheral (SID 2, 0x1300), for SweetBattery's apollo_chg: whether its SPMI channel is the
+ * apps EE's (the same ownership test as every other part here), and a write that only accepts the four registers
+ * smb5-lib.c's smblib_set_icl_current / smblib_icl_override touch (Xiaomi's smb5-reg.h, USBIN_BASE 0x1300):
+ * 0x42 CMD_ICL_OVERRIDE, 0x65 USBIN_LOAD_CFG, 0x66 USBIN_ICL_OPTIONS, 0x70 USBIN_CURRENT_LIMIT_CFG.
+ * Not an option of its own: nothing calls this unless SweetBattery has apollo_chg > 0.
+ */
+int apollo_pmic_usbin_ours(void);
+int apollo_pmic_usbin_write(unsigned reg, uint8_t value);
+
+int
+apollo_pmic_usbin_ours(void)
+{
+	return periph_find(&usbin_periph, true) ? 1 : 0;
+}
+
+int
+apollo_pmic_usbin_write(unsigned reg, uint8_t value)
+{
+	if (reg != 0x42 && reg != 0x65 && reg != 0x66 && reg != 0x70) {
+		return -1;
+	}
+	return spmi_write1(&usbin_periph, (uint8_t)reg, value);
+}
