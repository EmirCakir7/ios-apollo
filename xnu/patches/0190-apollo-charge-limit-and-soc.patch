+			ok = chargeWrite(1, optWant) && ok;
+		}
+		if (ovr != ovrWant) {
+			ok = chargeWrite(2, ovrWant) && ok;
+		}
+		if (load != loadWant) {
+			ok = chargeWrite(3, loadWant) && ok;
+		}
+	}
+	if (!ok && ++fChgFails >= 3) {
+		chargeRestore("writes do not stick");
+		fChgUnits = 0;
+		IOLog("SWEET BATT: apollo_chg gives up after 3 failed writes\n");
+	}
+}
