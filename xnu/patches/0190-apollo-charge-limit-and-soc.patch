+/* apollo (xnu 0190): write one of kChgRegs (by index), read it back, log both; true if it reads back as written */
+bool
+SweetBattery::chargeWrite(unsigned index, uint8_t value)
+{
+	uint8_t back = 0;
+	fChgChanged[index] = true;
+	bool wrote = apollo_pmic_usbin_write(kChgRegs[index], value) == 0;
+	bool read = !sweet_spmi_read(sweet_battery_sid, kChgRegs[index], &back);
+	IOLog("SWEET BATT: wrote %#06x %#x read back %#x%s\n", kChgRegs[index], value, back,
+	    !wrote ? " (write failed)" : (!read ? " (read back failed)" : ""));
+	return wrote && read && back == value;
+}
+
+/* the values the charger had before the first write, back (the limit first, then the mode bits) */
+void
+SweetBattery::chargeRestore(const char *why)
+{
+	if (!fChgActive) {
+		return;
+	}
+	IOLog("SWEET BATT: restoring the charger's previous values (%s)\n", why);
+	for (unsigned i = 0; i < 4; ++i) {
+		if (fChgChanged[i]) {
+			(void)chargeWrite(i, fChgSaved[i]);
+			fChgChanged[i] = false;
+		}
+	}
+	fChgActive = false;
+}
