+	/* smblib_icl_override(SW_OVERRIDE_HC_MODE): USBIN_MODE_CHG 1 (0x1366 bit 0), ICL_OVERRIDE 0 (0x1342 bit 0),
+	 * ICL_OVERRIDE_AFTER_APSD 1 (0x1365 bit 4); only needed when the limit is raised above USB's 500 mA */
+	const bool high = units > 5;
+	const uint8_t optWant = (uint8_t)(opt | 0x01), ovrWant = (uint8_t)(ovr & ~0x01), loadWant = (uint8_t)(load | 0x10);
+	const bool modeOk = !high || (opt == optWant && ovr == ovrWant && load == loadWant);
+	if (high ? (cur == want && modeOk) : cur <= want) {
+		return; /* already as wanted (or already lower than the USB default) */
+	}
+	if (!fChgActive) {
+		fChgSaved[0] = cur;
+		fChgSaved[1] = opt;
+		fChgSaved[2] = ovr;
+		fChgSaved[3] = load;
+		fChgActive = true;
+	}
