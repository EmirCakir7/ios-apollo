+/* (0197) apollo_idle=1: set by the governor once the display has been dark for GOV_IDLE_SETTLE_S, cleared the moment it turns on */
+static int sweet_idle_active;
+static int gov_chan;
+
+int
+sweet_idle_dark(void)
+{
+	return __atomic_load_n(&sweet_idle_active, __ATOMIC_ACQUIRE);
+}
+
+/* SweetFramebuffer.cpp: the display is turned on (sweet_display_dark is clear already): the pollers go back to normal at once */
+void
+sweet_idle_wake(void)
+{
+	__atomic_store_n(&sweet_idle_active, 0, __ATOMIC_RELEASE);
+	thread_wakeup((event_t)&gov_chan);
+}
+
+static void
+gov_wait(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&gov_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* (0197) the memory bus vote, with the failures counted: after 3 in a row it is not tried again for a while */
+struct gov_ddr {
+	unsigned fails;
+	uint64_t retry_at;
+	bool pinned;            /* sweet_rpmh_ddr_set() will not lower it (sweetddr=2, the default, or 0) */
+	bool unsupported;       /* ... not even for apollo_idle (sweetddr=0, or the first vote failed) */
+};
+
+/* One vote up (TOP) or down; IS_TOP is the state before; what the state is afterwards */
+static bool
+gov_ddr(bool top, bool is_top, const char *reason, bool dark, struct gov_ddr *s)
+{
+	int error = sweet_rpmh_ddr_set(top, reason, dark);
+	uint64_t span;
+
+	if (error == 0) {
+		s->fails = 0;
+		return top;
+	}
+	if (error == ENOTSUP) {
+		if (dark) {
+			s->unsupported = true;
+		} else {
+			s->pinned = true;
+		}
+		return is_top;
+	}
+	if (++s->fails >= 3) {
+		s->fails = 0;
+		nanoseconds_to_absolutetime((uint64_t)(top ? 1 : 30) * NSEC_PER_SEC, &span);
+		s->retry_at = mach_absolute_time() + span;
+		printf("SWEET RPMH: memory bus %s (%s) failed 3 times (errno %d): not tried again for %u s\n", top ? "raise" : "lower",
+			reason, error, top ? 1u : 30u);
+	}
+	return is_top;
+}
