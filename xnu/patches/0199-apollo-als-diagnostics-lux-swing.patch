+/* (xnu 0199) sweetlux_hi=N swaps the light between sweetlux and N every 20 s: auto-brightness, once the switch is
+ * there and on, then makes the screen brighter and dimmer by itself. */
+#define SWEET_LUX_SWING_US 20000000
+IOHIDEvent *
+SweetHIDALS::nextEvent(uint64_t now, UInt32 us)
+{
+	if (gSweetLuxHi > 0 && us != 0) {
+		fSwingUs += us;
+		if (fSwingUs >= SWEET_LUX_SWING_US) {
+			fSwingUs = 0;
+			fHigh = !fHigh;
+			IOLog("SWEET HID: SweetHIDALS light now %d lux\n", fHigh ? gSweetLuxHi : gSweetLux);
+		}
+	}
+	return SweetHIDMotion::nextEvent(now, us);
+}
