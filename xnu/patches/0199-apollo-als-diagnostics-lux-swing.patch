+/*
+ * (xnu 0199) What the clients ask of a sensor service: each (service, key) pair is logged once, as
+ * "SWEET HID: <service> property query '<key>': found|not there". A key that CoreBrightness or CoreMotion
+ * wants and the service lacks shows here, as does a service no client ever asks about.
+ */
+#define SWEET_PROP_SEEN_MAX 128
+#define SWEET_PROP_TAG_LEN  72
+static char gSweetPropSeen[SWEET_PROP_SEEN_MAX][SWEET_PROP_TAG_LEN];
+static unsigned gSweetPropSeenCount;
+
+static void
+sweet_log_property_query(const char *service, const char *key, bool found)
+{
+	char tag[SWEET_PROP_TAG_LEN];
+
+	if (!gSweetPropLock || !service || !key) {
+		return;
+	}
+	snprintf(tag, sizeof(tag), "%s/%s", service, key);
+	IOLockLock(gSweetPropLock);
+	for (unsigned i = 0; i < gSweetPropSeenCount; i++) {
+		if (strncmp(gSweetPropSeen[i], tag, sizeof(tag)) == 0) {
+			IOLockUnlock(gSweetPropLock);
+			return;
+		}
+	}
+	if (gSweetPropSeenCount < SWEET_PROP_SEEN_MAX) {
+		strlcpy(gSweetPropSeen[gSweetPropSeenCount++], tag, sizeof(gSweetPropSeen[0]));
+	}
+	IOLockUnlock(gSweetPropLock);
+	IOLog("SWEET HID: %s property query '%s': %s\n", service, key, found ? "found" : "not there");
+}
