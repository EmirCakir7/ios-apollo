+
+IOHIDEvent *
+SweetHIDMotion::nextEvent(uint64_t now, UInt32 us)
+{
+	fCountLogUs += us;
+	fCount++;
+	if (fCountLogUs >= 10000000) {
+		fCountLogUs = 0;
+		IOLog("SWEET HID: %s %u events sent, %u clients\n", getName(), (unsigned)fCount,
+		    _clients ? (unsigned)_clients->getCount() : 0);
+	}
+	return makeEvent(now);
+}
